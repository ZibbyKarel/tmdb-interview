{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/server/TmdbProxy.Api.csproj"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet publish apps/server/TmdbProxy.Api.csproj -c Release -o dist/apps/server"
      }
    }
  },
  "tags": []
}
