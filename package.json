{
  "name": "tmdb-interview",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "start": "nx serve client-web",
    "start:server": "nx serve server",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "typecheck": "tsc --noEmit -p .storybook/tsconfig.json && tsc --noEmit -p apps/client-web/tsconfig.app.json && tsc --noEmit -p apps/e2e/tsconfig.json && tsc --noEmit -p libs/design-system/tsconfig.json && tsc --noEmit -p libs/internationalization/tsconfig.json",
    "test": "jest --config jest.config.ts",
    "e2e": "playwright test --config apps/e2e/playwright.config.ts",
    "e2e:mocked": "ENABLE_MOCKING=true playwright test --config apps/e2e/playwright.config.ts",
    "format:check": "prettier . --check",
    "generate:api": "curl -fsSL https://developer.themoviedb.org/openapi/tmdb-api.json -o api-doc.json && orval --config orval.config.ts",
    "format": "prettier . --write",
    "build:client-web": "nx build client-web",
    "verify:docker": "npm run typecheck && npm run format:check && npm run test && npm run e2e:mocked"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@nx/js": "^21.0.0",
    "@nx/react": "^21.0.0",
    "@nx/vite": "^21.0.0",
    "@playwright/test": "^1.58.2",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/postcss": "^4.1.3",
    "@tanstack/react-query": "^5.68.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "msw": "^2.12.14",
    "nx": "^21.0.0",
    "orval": "^7.21.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.1.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.167.5",
    "axios": "^1.8.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intersection-observer": "^10.0.3"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
